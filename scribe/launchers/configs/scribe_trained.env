# Settings of SCRIBE with the trained planning carrier; source it with set -a before a SCRIBE
# launcher.
TAG=scribe_trained
SYSTEMS=SCRIBE
SYSTEM=SCRIBE
SEEDS=${SEEDS:-0}
THETA=${SCRIBE_THETA0:?set SCRIBE_THETA0 (configs/site.env.example)}
THETA_PLANNING=${SCRIBE_PLANNING_CARRIER:?set SCRIBE_PLANNING_CARRIER to the trained planning carrier dir}
LEVERS=${LITREVIEW_ROOT:?set LITREVIEW_ROOT (configs/site.env.example)}/scribe/levers/writing_levers.json
