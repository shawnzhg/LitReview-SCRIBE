# Settings of SCRIBE (untrained), with the initial carrier in every window; source it with set -a
# before a SCRIBE launcher.
TAG=scribe_untrained
SYSTEMS=SCRIBE
SYSTEM=SCRIBE
SEEDS=${SEEDS:-0}
THETA=${SCRIBE_THETA0:?set SCRIBE_THETA0 (configs/site.env.example)}
THETA_PLANNING=$SCRIBE_THETA0
LEVERS=${LITREVIEW_ROOT:?set LITREVIEW_ROOT (configs/site.env.example)}/scribe/levers/writing_levers.json
