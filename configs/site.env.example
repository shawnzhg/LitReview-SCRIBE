# Site settings read by the launchers and modules: copy to site.env, replace each /path/to placeholder, then run
# `set -a; . ./site.env; set +a`. Set the variables your runs use.
LITREVIEW_ROOT=/path/to/LitReview-SCRIBE
SCRIBE_WORK_ROOT=/path/to/work
SCRIBE_TOOLCHAIN=/path/to/toolchain.sh
CCBENCH_ENV=/path/to/ccbench_env.sh
SCRIBE_RUN_PY=/path/to/harness-env/bin/python
SCRIBE_SERVE_PY=/path/to/vllm-env/bin/python
SCRIBE_TRAIN_PY=/path/to/kvskill-env/bin/python
SCRIBE_POOL_PY=/path/to/pool-env/bin/python
SCRIBE_POOL_PYTHONPATH=/path/to/pool-env-extra-packages
SCRIBE_EMBED_PY=/path/to/embed-env/bin/python
SCRIBE_HF_HOME=/path/to/hf_home
HF_HOME=$SCRIBE_HF_HOME
SCRIBE_MODEL_DIR=/path/to/Qwen3.8-27B-nothink
SCRIBE_THETA0=/path/to/training_out/initial_carrier
SCRIBE_EMBED_MODEL_DIR=/path/to/nomic-embed-text-v1
SCRIBE_GTE_MODEL_DIR=/path/to/gte-large-en-v1.5
SCRIBE_NLI_MODEL_DIR=/path/to/PubMedBERT-MNLI-MedNLI
SCRIBE_BGE_MODEL_DIR=/path/to/bge-base-en-v1.5
SCRIBE_DATA_ROOT=/path/to/data/test50
SCRIBE_RUNS_ROOT=$SCRIBE_DATA_ROOT/runs
SCRIBE_EVAL_TASKS=$SCRIBE_DATA_ROOT/eval_tasks.json
SCRIBE_ALLOWLISTS=$SCRIBE_DATA_ROOT/allowlists
SCRIBE_REF_YEARS=$SCRIBE_DATA_ROOT/ref_years.json
SCRIBE_DATASET_ROOT=$SCRIBE_DATA_ROOT/dataset
SCRIBE_BENCH_RESULTS=$SCRIBE_DATA_ROOT/benchmark_claims_root
SCRIBE_POOL_INDEX=$SCRIBE_DATA_ROOT/pool_index/bm25
SCRIBE_POOL_EDGES=$SCRIBE_DATA_ROOT/pool_index/edges
SCRIBE_POOL_CUTOFFS=$SCRIBE_DATA_ROOT/pool_corpus/cutoffs.json
POOL_GOLD_DIR=$SCRIBE_RUNS_ROOT/gold/dev
SCRIBE_POOL_META_SQLITE=$SCRIBE_DATA_ROOT/pool_meta_subset.sqlite
SCRIBE_BUDGET_CAPS=$SCRIBE_DATA_ROOT/same_pool/budget_caps.json
SCRIBE_KCAP=$SCRIBE_DATA_ROOT/same_pool/kcap.json
SCRIBE_TRAIN_MANIFEST=$SCRIBE_DATA_ROOT/train_manifest.jsonl
CCBENCH_ROOT=/path/to/ccbench_data
CCBENCH_PARENT=$SCRIBE_DATA_ROOT
CCBENCH_EVAL_SUBDIR=
CCBENCH_OUT=$CCBENCH_ROOT/out
WINDOWBENCH_ROOT=$SCRIBE_DATA_ROOT/benchmark
WINDOWBENCH_OUT=/path/to/windowbench_out
WINDOWBENCH_ROSTER_EXTRA=/path/to/roster_extra.json
WINDOWBENCH_MEMBERSHIP=$WINDOWBENCH_OUT/readout_membership.json
WINDOWBENCH_OUTLINE_WINDOW=$SCRIBE_DATA_ROOT/outline_window
ISO_ROOT=/path/to/work/isolated_scoring
SCRIBE_PLANNING_CARRIER=/path/to/trained_planning_carrier
COMMERCIAL_OUT=/path/to/commercial_agent_bundle
RUNS_ROOT=$SCRIBE_RUNS_ROOT
TASKLIST=$SCRIBE_EVAL_TASKS
CUTOFFS=$SCRIBE_POOL_CUTOFFS
POOL_INDEX=$SCRIBE_POOL_INDEX
POOL_EDGES=$SCRIBE_POOL_EDGES
POOL_MANIFEST=$SCRIBE_DATA_ROOT/pool_corpus/pool_manifest.json
HOSTPY=$SCRIBE_POOL_PY
SERVE_PY=$SCRIBE_SERVE_PY
POOL_PY=$SCRIBE_POOL_PY
POOL_PYTHONPATH=$SCRIBE_POOL_PYTHONPATH
BASELINE_INPUTS=/path/to/baseline_inputs
OPENAI_KEY_FILE=/path/to/openai_key_file
DRTULU_MODEL_DIR=/path/to/DR-Tulu-8B
DRTULU_AGENT_DIR=/path/to/dr-tulu/agent
DRTULU_PY=/path/to/drtulu-env/bin/python
